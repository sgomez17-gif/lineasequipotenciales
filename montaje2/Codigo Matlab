%% LINEAS EQUIPOTENCIALES - MONTAJE 2: BARRA (PLACA) + ELECTRODO PUNTUAL
clear; clc; close all;

%% 1. Datos
V0 = 10.1;              % Voltaje de la fuente [V]
barraPositiva = true;   % true: barra a V0 y punto a 0 V | false: al reves
Vbarra  = V0*barraPositiva;
Vpunto  = V0*(~barraPositiva);

% Barra: de (5,4) a (5,16), 1 cm de ancho extendida hacia la izquierda
xb = [4 5];             % x minimo y maximo de la barra
yb = [4 16];            % y minimo y maximo de la barra
q2 = [20 10];           % Electrodo puntual
a  = 0.5;               % Radio aproximado del electrodo puntual

niveles = [1 2 3];      % Voltajes de las lineas equipotenciales

%% 2. Potencial por el metodo de cargas equivalentes
% La barra se reemplaza por cargas lineales sobre su eje y el electrodo
% puntual por una carga en su centro. Se calculan las cargas para que el
% potencial sea Vbarra sobre la barra y Vpunto sobre el electrodo puntual
% (carga neta nula).
N  = 40;
src = [repmat(mean(xb),N,1), linspace(yb(1),yb(2),N)'];   % cargas en la barra
S   = [src; q2];                                          % todas las fuentes

t  = linspace(0,1,60)';
pb = [xb(1)*ones(60,1), yb(1)+diff(yb)*t;                 % borde de la barra
      xb(2)*ones(60,1), yb(1)+diff(yb)*t;
      xb(1)+diff(xb)*t, yb(1)*ones(60,1);
      xb(1)+diff(xb)*t, yb(2)*ones(60,1)];
th = linspace(0,2*pi,25)'; th(end) = [];
pp = q2 + a*[cos(th) sin(th)];                            % borde del punto

Afun = @(P) -log(max(hypot(P(:,1)-S(:,1)', P(:,2)-S(:,2)'),1e-6));

M = [Afun(pb) ones(size(pb,1),1);
     Afun(pp) ones(size(pp,1),1);
     ones(1,size(S,1)) 0];
b = [Vbarra*ones(size(pb,1),1); Vpunto*ones(size(pp,1),1); 0];
sol = M\b;                                                % minimos cuadrados

Vfun = @(P) [Afun(P) ones(size(P,1),1)]*sol;              % V en puntos [x y]

h = 0.05;
[X,Y] = meshgrid(0:h:25, 0:h:20);
V = reshape(Vfun([X(:) Y(:)]), size(X));

%% 3. Puntos experimentales (x y) ordenados a lo largo de cada curva
p3 = [4 19; 7 17; 6 13];     % 3 V
p2 = [9 20; 11 15; 7 7];     % 2 V
p1 = [10 15; 18 10; 10 5];   % 1 V
exper = {p3, 3; p2, 2; p1, 1};

%% 4. Cuadricula tipo papel milimetrado
niv = {0.1, [1.00 0.88 0.82], 0.3;
       0.5, [1.00 0.72 0.60], 0.6;
       1.0, [0.95 0.45 0.30], 1.0};

%% 5. Figura 1: lineas equipotenciales simuladas
figure('Color','w','Units','pixels','Position',[50 50 820 660]);
hold on; box on;
for k = 1:3
    px = 0:niv{k,1}:25;  py = 0:niv{k,1}:20;
    plot([px; px], repmat([0;20],1,numel(px)), 'Color',niv{k,2}, ...
         'LineWidth',niv{k,3},'HandleVisibility','off');
    plot(repmat([0;25],1,numel(py)), [py;py], 'Color',niv{k,2}, ...
         'LineWidth',niv{k,3},'HandleVisibility','off');
end
axis equal; xlim([0 25]); ylim([0 20]);
set(gca,'XTick',0:5:25,'YTick',0:5:20,'Layer','top');
xlabel('x (cm)'); ylabel('y (cm)');
title(sprintf('Lineas equipotenciales - Barra y electrodo puntual (%.1f V)',V0));

[C,hc] = contour(X,Y,V,niveles,'LineColor','k','LineWidth',1.3);
clabel(C,hc,'FontWeight','bold');

% Electrodos
cb = 'r'; cp = 'b';
if ~barraPositiva, cb = 'b'; cp = 'r'; end
rectangle('Position',[xb(1) yb(1) diff(xb) diff(yb)],'FaceColor',cb,'EdgeColor',cb);
plot(q2(1),q2(2),[cp 'o'],'MarkerSize',10,'MarkerFaceColor',cp);
text(mean(xb),yb(1)-1.2,sprintf('Barra (%g V)',Vbarra),'HorizontalAlignment','center');
text(q2(1),q2(2)-1.2,sprintf('Punto (%g V)',Vpunto),'HorizontalAlignment','center');

% Voltaje al pasar el cursor
activarHover(gcf,gca,Vfun);

%% 6. Tabla: puntos experimentales, potencial teorico y error
fila = [];
for g = 1:size(exper,1)
    P  = exper{g,1};
    Vm = exper{g,2}*ones(size(P,1),1);       % potencial medido
    Vt = Vfun(P);                            % potencial teorico en (x,y)
    er = abs(Vt-Vm)./Vt*100;
    fila = [fila; P Vm Vt er];
end
T = array2table(round(fila,2),'VariableNames', ...
    {'x_cm','y_cm','V_medido','V_teorico','Error_pct'});
T.Punto = (1:height(T))'; T = movevars(T,'Punto','Before',1);
disp('PUNTOS EXPERIMENTALES VS TEORICOS (MONTAJE 2):'); disp(T);


%% 7. Figura 2: comparacion teoria vs practica
figure('Color','w','Units','pixels','Position',[900 50 820 660]);
hold on; box on;
for k = 1:3
    px = 0:niv{k,1}:25;  py = 0:niv{k,1}:20;
    plot([px; px], repmat([0;20],1,numel(px)), 'Color',niv{k,2}, ...
         'LineWidth',niv{k,3},'HandleVisibility','off');
    plot(repmat([0;25],1,numel(py)), [py;py], 'Color',niv{k,2}, ...
         'LineWidth',niv{k,3},'HandleVisibility','off');
end
axis equal; xlim([0 25]); ylim([0 20]);
set(gca,'XTick',0:5:25,'YTick',0:5:20,'Layer','top');
xlabel('x (cm)'); ylabel('y (cm)');
title('Comparacion: lineas equipotenciales teoricas vs. practica');

col3 = [0.49 0.18 0.56];   % 3 V
col2 = [0.00 0.45 0.74];   % 2 V
col1 = [0.85 0.33 0.10];   % 1 V
cols = {col3, col2, col1};

% Teoricas: continuas y delgadas
contour(X,Y,V,[3 3],'LineColor',col3,'LineWidth',1.2,'HandleVisibility','off');
contour(X,Y,V,[2 2],'LineColor',col2,'LineWidth',1.2,'HandleVisibility','off');
contour(X,Y,V,[1 1],'LineColor',col1,'LineWidth',1.2,'HandleVisibility','off');

% Electrodos
rectangle('Position',[xb(1) yb(1) diff(xb) diff(yb)],'FaceColor',cb,'EdgeColor',cb);
plot(q2(1),q2(2),[cp 'o'],'MarkerSize',10,'MarkerFaceColor',cp,'HandleVisibility','off');
text(mean(xb),yb(1)-1.2,sprintf('Barra (%g V)',Vbarra),'HorizontalAlignment','center');
text(q2(1),q2(2)-1.2,sprintf('Punto (%g V)',Vpunto),'HorizontalAlignment','center');

% Practica: arcos suaves (discontinuas y gruesas)
for g = 1:size(exper,1)
    P  = exper{g,1};
    s  = [0; cumsum(hypot(diff(P(:,1)), diff(P(:,2))))];
    ss = linspace(0, s(end), 400);
    plot(pchip(s,P(:,1),ss), pchip(s,P(:,2),ss),'--','Color',cols{g}, ...
         'LineWidth',2.8,'DisplayName',sprintf('%d V (practica)',exper{g,2}));
end

% Para ver tambien los puntos leidos, quita los % de esta linea:
% plot(fila(:,1),fila(:,2),'k.','MarkerSize',14,'HandleVisibility','off');

plot(NaN,NaN,'-','Color',[0.3 0.3 0.3],'LineWidth',1.2, ...
     'DisplayName','Teoricas (lineas continuas finas)');
plot(NaN,NaN,'--','Color',[0.3 0.3 0.3],'LineWidth',2.8, ...
     'DisplayName','Practica (lineas discontinuas gruesas)');
legend('Location','eastoutside');
activarHover(gcf,gca,Vfun);   % voltaje teorico al pasar el cursor

