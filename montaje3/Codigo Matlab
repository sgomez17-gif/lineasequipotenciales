%% Funciones locales: muestran el voltaje teorico bajo el cursor
function activarHover(fig,ax,Vfun)
    txt = text(ax,0.3,19.2,'','BackgroundColor','w','EdgeColor','k', ...
               'FontWeight','bold','VerticalAlignment','top', ...
               'HandleVisibility','off');
    set(fig,'WindowButtonMotionFcn',@(~,~) mover(ax,Vfun,txt));
end

function mover(ax,Vfun,txt)
    cp = ax.CurrentPoint(1,1:2);
    if cp(1)>=0 && cp(1)<=25 && cp(2)>=0 && cp(2)<=20
        txt.String = sprintf('x = %.2f cm   y = %.2f cm   V = %.2f V', ...
                             cp(1),cp(2),Vfun(cp));
    else
        txt.String = '';
    end
end
